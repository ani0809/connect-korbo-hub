# Dedicated queue names
QUEUE_DEFAULT=default
QUEUE_ACCOUNTING=accounting
QUEUE_MIGRATIONS=migrations
QUEUE_IMPORTS=imports
QUEUE_NEWSLETTERS=newsletters

# Migration source database (optional, for direct DB import)
MIGRATION_DB_CONNECTION=mysql
